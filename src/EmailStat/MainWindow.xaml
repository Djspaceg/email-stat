<Window
    x:Class="EmailStat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EmailStat.Controls"
    xmlns:converters="using:EmailStat.Converters"
    xmlns:vm="using:EmailStat.ViewModels">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!--  Toolbar  -->
            <RowDefinition Height="Auto" />
            <!--  Progress bar (hidden when idle)  -->
            <RowDefinition Height="Auto" />
            <!--  Main content  -->
            <RowDefinition Height="*" />
            <!--  Detail bar  -->
            <RowDefinition Height="Auto" />
            <!--  Status bar  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ════════════════════════════════
              Toolbar
              ════════════════════════════════ -->
        <Grid
            Grid.Row="0"
            Padding="8,4"
            Background="{ThemeResource SystemAccentColorDark2}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Left: action buttons  -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="4">

                <Button
                    x:Name="connectButton"
                    Click="ConnectButton_Click"
                    IsEnabled="{x:Bind not ViewModel.IsLoading, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE715;" />
                        <TextBlock Text="Connect to Gmail" />
                    </StackPanel>
                </Button>

                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    IsEnabled="{x:Bind not ViewModel.IsLoading, Mode=OneWay}"
                    ToolTipService.ToolTip="Re-fetch email data">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>

                <Button
                    Command="{x:Bind ViewModel.CancelCommand}"
                    IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    ToolTipService.ToolTip="Cancel current operation">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                </Button>
            </StackPanel>

            <!--  Centre: grouping toggle  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    Foreground="White"
                    Text="Group by:"
                    VerticalAlignment="Center" />
                <ToggleButton
                    x:Name="groupDomainToggle"
                    Checked="GroupToggle_Changed"
                    IsChecked="{x:Bind ViewModel.GroupByDomain, Mode=TwoWay}"
                    ToolTipService.ToolTip="Toggle between domain grouping and exact-address grouping"
                    Unchecked="GroupToggle_Changed">
                    <TextBlock x:Name="groupToggleLabel" Text="Domain" />
                </ToggleButton>
            </StackPanel>

            <!--  Right: max-messages input  -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    Foreground="White"
                    Text="Max emails:"
                    VerticalAlignment="Center" />
                <NumberBox
                    x:Name="maxMessagesBox"
                    Width="100"
                    Maximum="100000"
                    Minimum="100"
                    SmallChange="500"
                    SpinButtonPlacementMode="Compact"
                    ToolTipService.ToolTip="Maximum number of messages to inspect"
                    Value="{x:Bind ViewModel.MaxMessages, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!--  ════════════════════════════════
              Progress indicator
              ════════════════════════════════ -->
        <ProgressBar
            Grid.Row="1"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!--  ════════════════════════════════
              Main content area
              ════════════════════════════════ -->
        <Grid Grid.Row="2">

            <!--  Treemap (shown when data is available and not loading)  -->
            <controls:TreemapControl
                x:Name="treemapControl"
                Items="{x:Bind ViewModel.EmailGroups, Mode=OneWay}"
                SelectedGroupChanged="Treemap_SelectedGroupChanged"
                Visibility="{x:Bind ViewModel.HasData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!--  Empty / welcome state  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="72"
                    Glyph="&#xE715;"
                    Opacity="0.4" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Visualise your Gmail inbox" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.5"
                    Text="Connect to Gmail and the treemap will show you&#x0a;which senders or domains are filling your inbox." />

                <Button
                    HorizontalAlignment="Center"
                    Click="ConnectButton_Click"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE715;" />
                        <TextBlock Text="Connect to Gmail" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Loading overlay (spinner centred over the treemap)  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing
                    Width="56"
                    Height="56"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  ════════════════════════════════
              Selected-group detail bar
              ════════════════════════════════ -->
        <Border
            Grid.Row="3"
            Padding="12,4"
            Background="{ThemeResource SystemAccentColorDark1}"
            Visibility="{x:Bind ViewModel.HasData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                Foreground="White"
                Opacity="0.9"
                Text="{x:Bind ViewModel.SelectedGroupInfo, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Border>

        <!--  ════════════════════════════════
              Status bar
              ════════════════════════════════ -->
        <Border
            Grid.Row="4"
            Padding="12,3"
            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                Opacity="0.75"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
